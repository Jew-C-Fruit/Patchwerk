{
  "name": "board-dense",
  "patch": "pad_space",
  "note": "Item 37 Phase 2 / todo P2-5. A DENSE board, captured from a real server rather than hand-written, so the card builders and the gutter wire router are exercised against geometry nobody chose. Every node here is spawnable WITHOUT a rack (voices are not: spawn_voice needs a module to target), which is the whole reason this can be recorded on a machine with no audio — and also its limit: it is a dense CONTROL board, not the ~40-module board P2-5 asks for. That one still wants Cole's live rig; this does not discharge it.",
  "steps": [
    {"do": "mark", "label": "spawn"},
    {"do": "send", "msg": {"type": "spawn_transport_card", "which": "play"}},
    {"do": "send", "msg": {"type": "spawn_transport_card", "which": "tempo"}},
    {"do": "spawn", "type": "spawn_button", "as": "b1"},
    {"do": "spawn", "type": "spawn_button", "as": "b2"},
    {"do": "spawn", "type": "spawn_button", "as": "b3"},
    {"do": "spawn", "type": "spawn_button", "as": "b4"},
    {"do": "spawn", "type": "spawn_button", "as": "b5"},
    {"do": "spawn", "type": "spawn_button", "as": "b6"},
    {"do": "spawn", "type": "spawn_clock", "as": "c1"},
    {"do": "spawn", "type": "spawn_clock", "as": "c2"},
    {"do": "spawn", "type": "spawn_clock", "as": "c3"},
    {"do": "spawn", "type": "spawn_logic", "as": "l1"},
    {"do": "spawn", "type": "spawn_logic", "as": "l2"},
    {"do": "spawn", "type": "spawn_logic", "as": "l3"},
    {"do": "spawn", "type": "spawn_relay", "as": "r1"},
    {"do": "spawn", "type": "spawn_relay", "as": "r2"},
    {"do": "spawn", "type": "spawn_keyshift", "as": "k1"},
    {"do": "spawn", "type": "spawn_keyshift", "as": "k2"},
    {"do": "spawn", "type": "spawn_tonic", "as": "t1"},
    {"do": "spawn", "type": "spawn_tonic", "as": "t2"},
    {"do": "spawn", "type": "spawn_literal", "as": "li1"},
    {"do": "spawn", "type": "spawn_literal", "as": "li2"},

    {"do": "mark", "label": "wire-bin"},
    {"do": "send", "msg": {"type": "set_button", "id": "$b1", "latch": true}},
    {"do": "send", "msg": {"type": "set_button", "id": "$b2", "latch": true}},
    {"do": "send", "msg": {"type": "set_button", "id": "$b3", "latch": true}},
    {"do": "wire", "from": "$b1", "to": "$l1:a"},
    {"do": "wire", "from": "$b2", "to": "$l1:b"},
    {"do": "wire", "from": "$c1", "to": "$l2:a"},
    {"do": "wire", "from": "$b3", "to": "$l2:b"},
    {"do": "wire", "from": "$l1", "to": "$l3:a"},
    {"do": "wire", "from": "$l2", "to": "$l3:b"},
    {"do": "wire", "from": "$l3", "to": "transport:run"},
    {"do": "wire", "from": "$b4", "to": "transport:click"},
    {"do": "wire", "from": "$b5", "to": "$r1:ctl"},
    {"do": "wire", "from": "$b6", "to": "$r2:ctl"},
    {"do": "wire", "from": "$c2", "to": "$t1"},
    {"do": "wire", "from": "$c3", "to": "deck:rec"},

    {"do": "mark", "label": "wire-ctl"},
    {"do": "wire", "from": "keys", "to": "$k1:1"},
    {"do": "wire", "from": "$k1:1", "to": "$t1"},
    {"do": "wire", "from": "$t1", "to": "$k2:1"},
    {"do": "wire", "from": "keys", "to": "$k2:2"},
    {"do": "wire", "from": "$k2:2", "to": "$li1"},
    {"do": "wire", "from": "$li1", "to": "deck"},
    {"do": "wire", "from": "keys", "to": "$t2"},
    {"do": "wire", "from": "$t2", "to": "$li2"},
    {"do": "wire", "from": "$li2", "to": "arp"},
    {"do": "wire", "from": "arp", "to": "$t2"},
    {"do": "wire", "from": "deck", "to": "$k1:3"},

    {"do": "mark", "label": "settled"},
    {"do": "poke"},
    {"do": "send", "msg": {"type": "remove_transport_card", "which": "play"}},
    {"do": "send", "msg": {"type": "remove_transport_card", "which": "tempo"}},
    {"do": "restore"}
  ]
}
