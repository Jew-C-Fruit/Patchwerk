{
  "name": "indicators",
  "patch": "pad_space",
  "note": "Item 37 Phase 2. ONE scenario that drives EVERY reactive-indicator endpoint the control plane can reach without a rack, so one recording feeds the whole endpoint x surface matrix. Steady endpoints are driven high AND LOW — the falling edge is the one that separates a surface that is reacting from one that merely got lit earlier (reactive-taps-gui-handoff.md section 4). Pulse endpoints are fired once each; their on/off pair lands in the SAME tick, which is the zero-duration hazard the replay exists to prove against.",
  "steps": [
    {"do": "mark", "label": "setup"},
    {"do": "send", "msg": {"type": "spawn_transport_card", "which": "play"}},
    {"do": "send", "msg": {"type": "spawn_transport_card", "which": "tempo"}},
    {"do": "spawn", "type": "spawn_button", "as": "run"},
    {"do": "spawn", "type": "spawn_button", "as": "clk"},
    {"do": "spawn", "type": "spawn_button", "as": "acc"},
    {"do": "spawn", "type": "spawn_button", "as": "arp"},
    {"do": "spawn", "type": "spawn_button", "as": "drm"},
    {"do": "spawn", "type": "spawn_button", "as": "mom"},
    {"do": "spawn", "type": "spawn_tonic", "as": "ton"},
    {"do": "spawn", "type": "spawn_relay", "as": "rly"},
    {"do": "spawn", "type": "spawn_button", "as": "rc"},
    {"do": "send", "msg": {"type": "set_button", "id": "$run", "latch": true}},
    {"do": "send", "msg": {"type": "set_button", "id": "$clk", "latch": true}},
    {"do": "send", "msg": {"type": "set_button", "id": "$acc", "latch": true}},
    {"do": "send", "msg": {"type": "set_button", "id": "$arp", "latch": true}},
    {"do": "send", "msg": {"type": "set_button", "id": "$drm", "latch": true}},
    {"do": "send", "msg": {"type": "set_button", "id": "$rc", "latch": true}},
    {"do": "send", "msg": {"type": "set_button", "id": "$mom", "latch": false}},
    {"do": "wire", "from": "$run", "to": "transport:run"},
    {"do": "wire", "from": "$clk", "to": "transport:click"},
    {"do": "wire", "from": "$acc", "to": "transport:accent"},
    {"do": "wire", "from": "$arp", "to": "arp:pwr"},
    {"do": "wire", "from": "$drm", "to": "drums:pwr"},
    {"do": "wire", "from": "$rc", "to": "$rly:ctl"},

    {"do": "mark", "label": "steady-high"},
    {"do": "send", "msg": {"type": "fire_button", "id": "$run"}, "poke": false},
    {"do": "wait", "s": 0.2},
    {"do": "send", "msg": {"type": "fire_button", "id": "$clk"}, "poke": false},
    {"do": "wait", "s": 0.2},
    {"do": "send", "msg": {"type": "fire_button", "id": "$acc"}, "poke": false},
    {"do": "wait", "s": 0.2},
    {"do": "send", "msg": {"type": "fire_button", "id": "$arp"}, "poke": false},
    {"do": "wait", "s": 0.2},
    {"do": "send", "msg": {"type": "fire_button", "id": "$drm"}, "poke": false},
    {"do": "wait", "s": 0.2},
    {"do": "send", "msg": {"type": "fire_button", "id": "$rc"}, "poke": false},
    {"do": "wait", "s": 0.3},
    {"do": "poke"},

    {"do": "mark", "label": "steady-low"},
    {"do": "send", "msg": {"type": "fire_button", "id": "$run"}, "poke": false},
    {"do": "wait", "s": 0.2},
    {"do": "send", "msg": {"type": "fire_button", "id": "$clk"}, "poke": false},
    {"do": "wait", "s": 0.2},
    {"do": "send", "msg": {"type": "fire_button", "id": "$acc"}, "poke": false},
    {"do": "wait", "s": 0.2},
    {"do": "send", "msg": {"type": "fire_button", "id": "$arp"}, "poke": false},
    {"do": "wait", "s": 0.2},
    {"do": "send", "msg": {"type": "fire_button", "id": "$drm"}, "poke": false},
    {"do": "wait", "s": 0.2},
    {"do": "send", "msg": {"type": "fire_button", "id": "$rc"}, "poke": false},
    {"do": "wait", "s": 0.3},
    {"do": "poke"},

    {"do": "mark", "label": "pulse-tap"},
    {"do": "wire", "from": "$mom", "to": "transport:tap"},
    {"do": "send", "msg": {"type": "fire_button", "id": "$mom"}, "poke": false},
    {"do": "wait", "s": 0.5},
    {"do": "send", "msg": {"type": "fire_button", "id": "$mom"}, "poke": false},
    {"do": "wait", "s": 0.5},
    {"do": "send", "msg": {"type": "fire_button", "id": "$mom"}, "poke": false},
    {"do": "wait", "s": 0.3},
    {"do": "unwire", "from": "$mom", "to": "transport:tap"},

    {"do": "mark", "label": "pulse-deck-rec"},
    {"do": "wire", "from": "$mom", "to": "deck:rec"},
    {"do": "send", "msg": {"type": "fire_button", "id": "$mom"}, "poke": false},
    {"do": "wait", "s": 0.3},
    {"do": "unwire", "from": "$mom", "to": "deck:rec"},

    {"do": "mark", "label": "pulse-deck-play"},
    {"do": "wire", "from": "$mom", "to": "deck:play"},
    {"do": "send", "msg": {"type": "fire_button", "id": "$mom"}, "poke": false},
    {"do": "wait", "s": 0.3},
    {"do": "unwire", "from": "$mom", "to": "deck:play"},

    {"do": "mark", "label": "pulse-deck-stop"},
    {"do": "wire", "from": "$mom", "to": "deck:stop"},
    {"do": "send", "msg": {"type": "fire_button", "id": "$mom"}, "poke": false},
    {"do": "wait", "s": 0.3},
    {"do": "unwire", "from": "$mom", "to": "deck:stop"},

    {"do": "mark", "label": "pulse-deck-clear"},
    {"do": "wire", "from": "$mom", "to": "deck:clear"},
    {"do": "send", "msg": {"type": "fire_button", "id": "$mom"}, "poke": false},
    {"do": "wait", "s": 0.3},
    {"do": "unwire", "from": "$mom", "to": "deck:clear"},

    {"do": "mark", "label": "pulse-deriver"},
    {"do": "wire", "from": "$mom", "to": "$ton"},
    {"do": "send", "msg": {"type": "fire_button", "id": "$mom"}, "poke": false},
    {"do": "wait", "s": 0.3},

    {"do": "mark", "label": "settled"},
    {"do": "poke"},
    {"do": "send", "msg": {"type": "remove_transport_card", "which": "play"}},
    {"do": "send", "msg": {"type": "remove_transport_card", "which": "tempo"}},
    {"do": "restore"}
  ]
}
